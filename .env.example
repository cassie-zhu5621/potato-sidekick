# Copy this file to .env and replace the placeholder with your own key.
GEMINI_API_KEY=your_gemini_api_key_here

# Lowest-latency Gemini defaults. Override individual values when an experiment
# needs more visual detail or reasoning quality.
NOTICEBOT_GEMINI_MODEL=gemini-3.5-flash
NOTICEBOT_GEMINI_THINKING_LEVEL=minimal
# 256 truncated the planner's JSON mid-string on a five-frame room.
NOTICEBOT_GEMINI_MAX_OUTPUT_TOKENS=8192
NOTICEBOT_GEMINI_SERVICE_TIER=priority

# Grounding DINO is the default detector and runs at about 1 Hz on the current
# laptop. Use --detector yoloworld --cv-hz 4 for the faster optional path.
NOTICEBOT_CV_HZ=1

# Which LLM answers. Default gemini -- omitting this changes nothing.
# The two providers share the prompts, the schemas and the audit format, so a
# session can be compared across them rather than across two pipelines.
NOTICEBOT_LLM_PROVIDER=gemini

# Only read when NOTICEBOT_LLM_PROVIDER=anthropic. pip install anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# NOTICEBOT_ANTHROPIC_MODEL=claude-sonnet-5
# NOTICEBOT_ANTHROPIC_MAX_OUTPUT_TOKENS=8192
